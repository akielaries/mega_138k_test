module Gowin_PLL (
  HCLK,
  DDR_STOP,
  GTX_CLK,
  EPHY_CLK_d,
  DDR_MEM_CLK,
  pll_lock,
  n20_6,
  enable_r
)
;
input HCLK;
input DDR_STOP;
output GTX_CLK;
output EPHY_CLK_d;
output DDR_MEM_CLK;
output pll_lock;
output n20_6;
output [1:1] enable_r;
wire pll_lock_1;
wire pll_rst;
wire [2:0] lpfres;
wire [1:0] icpsel;
wire VCC;
wire GND;
  Gowin_PLL_MOD u_pll (
    .HCLK(HCLK),
    .pll_rst(pll_rst),
    .DDR_STOP(DDR_STOP),
    .icpsel(icpsel[1:0]),
    .lpfres(lpfres[2:0]),
    .pll_lock(pll_lock_1),
    .GTX_CLK(GTX_CLK),
    .EPHY_CLK_d(EPHY_CLK_d),
    .DDR_MEM_CLK(DDR_MEM_CLK)
);
  PLL_INIT u_pll_init (
    .HCLK(HCLK),
    .pll_lock(pll_lock_1),
    .pll_rst(pll_rst),
    .pll_lock_0(pll_lock),
    .n20_6(n20_6),
    .lpfres(lpfres[2:0]),
    .icpsel(icpsel[1:0]),
    .enable_r(enable_r[1])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* Gowin_PLL */
module Gowin_PLL_ffc_MOD (
  HCLK,
  pll_rst,
  icpsel,
  lpfres,
  pll_lock,
  multiflex_clk_fast
)
;
input HCLK;
input pll_rst;
input [0:0] icpsel;
input [2:0] lpfres;
output pll_lock;
output multiflex_clk_fast;
wire clkout1;
wire clkout2;
wire clkout3;
wire clkout4;
wire clkout5;
wire clkout6;
wire clkfbout;
wire VCC;
wire GND;
  PLL PLL_inst (
    .LOCK(pll_lock),
    .CLKOUT0(multiflex_clk_fast),
    .CLKOUT1(clkout1),
    .CLKOUT2(clkout2),
    .CLKOUT3(clkout3),
    .CLKOUT4(clkout4),
    .CLKOUT5(clkout5),
    .CLKOUT6(clkout6),
    .CLKFBOUT(clkfbout),
    .CLKIN(HCLK),
    .CLKFB(GND),
    .RESET(pll_rst),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .FBDSEL({GND,GND,GND,GND,GND,GND}),
    .IDSEL({GND,GND,GND,GND,GND,GND}),
    .MDSEL({GND,GND,GND,GND,GND,GND,GND}),
