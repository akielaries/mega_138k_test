module prbs7_single_channel (
  ln1_tx_pcs_clk,
  n6_6,
  ln1_rx_pcs_clk,
  ln1_prbs7_chk_data,
  sfp_stat,
  prbs_tmp,
  ln1_prbs7_gen_data,
  sfp_stat_55
)
;
input ln1_tx_pcs_clk;
input n6_6;
input ln1_rx_pcs_clk;
input [7:0] ln1_prbs7_chk_data;
input [11:11] sfp_stat;
output [5:0] prbs_tmp;
output [1:0] ln1_prbs7_gen_data;
output [7:7] sfp_stat_55;
wire VCC;
wire GND;
  prbs7_gen prbs7_gen (
    .ln1_tx_pcs_clk(ln1_tx_pcs_clk),
    .n6_6(n6_6),
    .prbs_tmp(prbs_tmp[5:0]),
    .ln1_prbs7_gen_data(ln1_prbs7_gen_data[1:0])
);
  prbs7_chk prbs7_chk (
    .ln1_rx_pcs_clk(ln1_rx_pcs_clk),
    .ln1_prbs7_chk_data(ln1_prbs7_chk_data[7:0]),
    .sfp_stat(sfp_stat[11]),
    .sfp_stat_54(sfp_stat_55[7])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* prbs7_single_channel */
